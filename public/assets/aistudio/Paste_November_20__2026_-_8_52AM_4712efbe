        if (state.eqPreset === 'auto') applyEqualizerPreset('auto', false);
        if (autoScrollList) scrollToActiveTrack(true);

        if (autoPlay && state.audioRoute === 'poweramp' && track.native_path) {
            state.audio.pause();
            if (sendPowerampCommand('play_file', track.native_path)) {
                state.isPlaying = true; state.isAudioBuffering = false;
                el['engine-badge'].textContent = 'POWERAMP OUT'; updatePlayUI(); return;
            }
        }

        el['engine-badge'].textContent = autoPlay ? 'BUFFERING...' : 'PURE 320K';
        state.audio.pause(); state.audio.src = buildProxyUrl(track.audio_url); applyAudioSettings(state.audio);

        if (autoPlay) {
            ensureWebAudioGraph();
            try {
                await state.audio.play();
                if (currentToken !== state.playToken) return;
                state.isPlaying = true; state.isAudioBuffering = false;
                el['engine-badge'].textContent = state.isOfflineMode ? 'OFFLINE DSP' : 'PURE 320K';
                applyAudioSettings(state.audio); updatePlayUI(); resizeCanvas(); startVisualizer(); processImageQueue(); preloadNextTrack();
            } catch (err) { state.isAudioBuffering = false; processImageQueue(); }
        } else { state.isAudioBuffering = false; processImageQueue(); }
    }

    function togglePlay() {
        if (state.audioRoute === 'poweramp' && sendPowerampCommand('toggle_play_pause')) {
            state.isPlaying = !state.isPlaying; updatePlayUI(); return;
        }
        ensureWebAudioGraph();
        if (!state.audio.src && state.tracks.length > 0) { selectTrack(state.currentIndex, true, true); return; }
        if (state.isPlaying) state.audio.pause();
        else {
            state.isAudioBuffering = true;
            state.audio.play().then(() => { state.isPlaying = true; state.isAudioBuffering = false; applyAudioSettings(state.audio); updatePlayUI(); resizeCanvas(); startVisualizer(); processImageQueue(); preloadNextTrack(); }).catch(() => { state.isAudioBuffering = false; processImageQueue(); });
        }
    }

    function updatePlayUI() { const s = state.isPlaying ? 'Ⅱ' : '▶'; el['play'].textContent = s; el['mini-play'].textContent = s; }
    function resetGpuTransforms() { ['artwork', 'hero-orb', 'brand-mark', 'amb-orb-1'].forEach(k => { if (el[k]) el[k].style.transform = ''; }); }

    function initAudioEvents() {
        state.audio.addEventListener('loadedmetadata', () => {
            if (state.tracks[state.currentIndex] && !state.tracks[state.currentIndex].duration && isFinite(state.audio.duration)) { state.tracks[state.currentIndex].duration = state.audio.duration; updateStats(); }
            if (state.pendingSeekTime > 0 && isFinite(state.audio.duration)) { state.audio.currentTime = Math.min(state.pendingSeekTime, Math.max(0, state.audio.duration - 2)); state.pendingSeekTime = 0; }
            applyAudioSettings(state.audio); updateLiveEta();
        });
        state.audio.addEventListener('playing', () => { state.isPlaying = true; state.isAudioBuffering = false; el['engine-badge'].textContent = state.isOfflineMode ? 'OFFLINE DSP' : 'PURE 320K'; applyAudioSettings(state.audio); updatePlayUI(); resizeCanvas(); startVisualizer(); processImageQueue(); preloadNextTrack(); });
        state.audio.addEventListener('pause', () => { state.isPlaying = false; state.isAudioBuffering = false; updatePlayUI(); resetGpuTransforms(); processImageQueue(); savePlayerState(true); });
        state.audio.addEventListener('error', () => { const tr = state.tracks[state.currentIndex]; if (tr && state.usingProxy && tr.audio_url.startsWith('http')) { state.usingProxy = false; state.audio.src = tr.audio_url; if (state.isPlaying) state.audio.play().catch(() => {}); } });
        state.audio.addEventListener('timeupdate', () => {
            const cur = state.audio.currentTime || 0, dur = (state.audio.duration && isFinite(state.audio.duration)) ? state.audio.duration : (state.tracks[state.currentIndex]?.duration || 0);
            el['elapsed'].textContent = formatTime(cur);
            if (dur > 0) { el['remaining'].textContent = '-' + formatTime(Math.max(0, dur - cur)); el['seek'].value = Math.min(1000, Math.floor((cur / dur) * 1000)); }
            updateLiveEta(); savePlayerState(false);
        });
        state.audio.addEventListener('ended', () => {
            if (state.repeatMode === 'one') { state.audio.currentTime = 0; state.audio.play().catch(() => {}); return; }
            if (state.repeatMode === 'off' && !state.isShuffle && state.currentIndex >= state.tracks.length - 1) { state.isPlaying = false; updatePlayUI(); return; }
            playNextTrack(false);
        });
    }

    function resizeCanvas() {
        const c = el['visualizer']; if (!c || !c.parentElement) return;
        const r = c.parentElement.getBoundingClientRect(); if (r.width < 10) return;
        const dpr = Math.min(1.5, window.devicePixelRatio || 1);
        state.canvasDpr = dpr; state.canvasW = Math.floor(r.width * dpr); state.canvasH = Math.floor(r.height * dpr);
        c.width = state.canvasW; c.height = state.canvasH;
    }

    function initCanvas() {
        const c = el['visualizer']; if (!c) return;
        state.canvasCtx = c.getContext('2d', { alpha: false }); resizeCanvas();
        window.addEventListener('resize', resizeCanvas);
        if ('ResizeObserver' in window) new ResizeObserver(() => resizeCanvas()).observe(c.parentElement);
    }

    function startVisualizer() {
        if (state.animFrameId) cancelAnimationFrame(state.animFrameId);
        const c = el['visualizer']; if (!c || !state.canvasCtx) return;
        const bars = 36, smooth = new Float32Array(bars), peaks = new Float32Array(bars);
        const render = (ts) => {
            if (!state.isPlaying) { resetGpuTransforms(); return; }
            state.animFrameId = requestAnimationFrame(render);
            const w = state.canvasW, h = state.canvasH, dpr = state.canvasDpr, ctx = state.canvasCtx;
            ctx.fillStyle = '#04070d'; ctx.fillRect(0, 0, w, h);
            const priHex = rgbToHex(state.activeAccent.r, state.activeAccent.g, state.activeAccent.b), secHex = rgbToHex(state.activeSec.r, state.activeSec.g, state.activeSec.b);
            let hasRealFreq = false, bassSum = 0, midSum = 0;
            if (state.webAudioConnected && state.analyser && state.freqData && state.timeData) {
                state.analyser.getByteFrequencyData(state.freqData); state.analyser.getByteTimeDomainData(state.timeData);
                for (let i = 0; i < 12; i++) if (state.freqData[i] > 0) { hasRealFreq = true; break; }
            }
            const t = (state.audio.currentTime || ts / 1000) * state.playbackSpeed, gap = Math.max(2, Math.floor(w * 0.006)), barW = Math.max(2, (w - gap * (bars + 1)) / bars);
            const grad = ctx.createLinearGradient(0, h, 0, 0); grad.addColorStop(0, priHex); grad.addColorStop(0.65, secHex); grad.addColorStop(1, '#ff2a85');
            for (let i = 0; i < bars; i++) {
                let target = hasRealFreq ? (state.freqData[Math.min(state.freqData.length - 1, Math.floor((i / bars) * (state.freqData.length * 0.85)))] / 255) * 0.90 : Math.min(0.9, (Math.sin(t * (6.0 + i * 0.25) + i * 0.5) * 0.5 + 0.5) * (1 - (i / bars) * 0.45) * (0.35 + Math.pow(Math.max(0, Math.sin(t * 7.2)), 2.5) * 0.55));
                if (i < 6) bassSum += target; else if (i < 18) midSum += target;
                smooth[i] += (target - smooth[i]) * 0.42; peaks[i] = smooth[i] > peaks[i] ? smooth[i] : Math.max(0, peaks[i] - 0.016);
                const bh = Math.max(2, smooth[i] * (h * 0.88)), x = gap + i * (barW + gap);
                ctx.fillStyle = grad; ctx.fillRect(x, h - bh, barW, bh);
                ctx.fillStyle = '#ffffff'; ctx.fillRect(x, Math.max(2, h - peaks[i] * (h * 0.88) - 2 * dpr), barW, Math.max(1.5, 1.8 * dpr));
            }
            const bassAvg = Math.min(1, (bassSum / 6) * 1.25), midAvg = Math.min(1, (midSum / 12) * 1.25);
            update8DSpatialNodes(ts, bassAvg, midAvg); runAdaptiveAutoEq(ts, hasRealFreq);
            ctx.beginPath(); ctx.lineWidth = Math.max(1.6, 2.0 * dpr); ctx.strokeStyle = '#ffffff';
            for (let i = 0; i < 36; i++) {
                const wx = (i / 35) * w, wy = (hasRealFreq && state.timeData) ? (h * 0.5) + ((state.timeData[Math.floor((i / 36) * state.timeData.length)] - 128) / 128) * (h * 0.35) : (h * 0.5) + Math.sin(t * 8.5 + i * 0.35) * (h * 0.16);
                if (i === 0) ctx.moveTo(wx, wy); else ctx.lineTo(wx, wy);
            }
            ctx.stroke();
            if (state.spatial) {
                const px = (Math.sin(state.orbitPhase) * 0.44 + 0.5) * w, py = (Math.cos(state.orbitPhase) * 0.25 + 0.35) * h;
                state.orbitTrail.push({ x: px, y: py }); if (state.orbitTrail.length > 10) state.orbitTrail.shift();
                state.orbitTrail.forEach((pt, idx) => { ctx.fillStyle = `rgba(${state.activeAccent.r}, ${state.activeAccent.g}, ${state.activeAccent.b}, ${(((idx + 1) / state.orbitTrail.length) * 0.65).toFixed(2)})`; ctx.beginPath(); ctx.arc(pt.x, pt.y, (1.8 + idx * 0.28) * dpr, 0, Math.PI * 2); ctx.fill(); });
                ctx.fillStyle = '#ffffff'; ctx.beginPath(); ctx.arc(px, py, (3.6 + bassAvg * 2.2) * dpr, 0, Math.PI * 2); ctx.fill();
            } else if (state.orbitTrail.length) state.orbitTrail.length = 0;
            const orbitShift = state.spatial ? (Math.sin(state.orbitPhase) * (6 + bassAvg * 5)).toFixed(1) : '0';
            if (el['artwork']) el['artwork'].style.transform = `translate3d(${orbitShift}px, 0, 0) scale(${(1 + bassAvg * 0.048).toFixed(3)})`;
            if (el['hero-orb']) el['hero-orb'].style.transform = `scale(${(1 + bassAvg * 0.22).toFixed(3)})`;
            if (el['brand-mark']) el['brand-mark'].style.transform = `scale(${(1 + bassAvg * 0.12).toFixed(3)})`;
        };
        state.animFrameId = requestAnimationFrame(render);
    }

    function updateMediaSession(track) {
        if (!('mediaSession' in navigator)) return;
        try {
            navigator.mediaSession.metadata = new MediaMetadata({ title: track.title, artist: track.artist, album: track.album, artwork: track.cover_url ? [{ src: track.cover_url, sizes: '512x512', type: 'image/jpeg' }] : [] });
            navigator.mediaSession.setActionHandler('play', togglePlay); navigator.mediaSession.setActionHandler('pause', togglePlay);
            navigator.mediaSession.setActionHandler('previoustrack', playPrevTrack); navigator.mediaSession.setActionHandler('nexttrack', () => playNextTrack(false));
        } catch (e) {}
    }

    function openMobileModal() { if (window.innerWidth > 1020) return; el['player-panel'].classList.add('mobile-fullscreen'); document.body.classList.add('modal-open'); if (location.hash !== '#player') history.pushState({ modal: true }, '', '#player'); setTimeout(resizeCanvas, 40); }
    function closeMobileModal() { el['player-panel'].classList.remove('mobile-fullscreen'); document.body.classList.remove('modal-open'); el['player-panel'].style.transform = ''; if (location.hash === '#player') history.back(); }

    function initSwipeToClose() {
        let startY = 0, currentY = 0, dragging = false; const panel = el['player-panel'];
        panel.addEventListener('touchstart', (e) => { if (!panel.classList.contains('mobile-fullscreen') || e.target.closest('input[type="range"]') || panel.scrollTop > 5) return; startY = e.touches[0].clientY; currentY = startY; dragging = true; panel.style.transition = 'none'; }, { passive: true });
        panel.addEventListener('touchmove', (e) => { if (!dragging) return; currentY = e.touches[0].clientY; if (currentY - startY > 0) panel.style.transform = `translateY(${(currentY - startY) * 0.85}px)`; }, { passive: true });
        panel.addEventListener('touchend', () => { if (!dragging) return; dragging = false; panel.style.transition = 'transform 0.2s ease'; if (currentY - startY > 85) closeMobileModal(); else panel.style.transform = ''; });
        el['modal-drag-bar'].addEventListener('click', closeMobileModal);
        window.addEventListener('popstate', () => { if (panel.classList.contains('mobile-fullscreen')) { panel.classList.remove('mobile-fullscreen'); document.body.classList.remove('modal-open'); panel.style.transform = ''; } });
    }

    function cycleRepeatMode() { const order = ['all', 'one', 'off']; state.repeatMode = order[(order.indexOf(state.repeatMode) + 1) % order.length]; updateRepeatUI(); updateTrackLocatorAndQueue(); savePlayerState(true); }

    function initEvents() {
        initSwipeToClose();
        setInterval(() => { updateLiveEta(); tickSleepTimer(); }, 1000);
        el['audio-route-btn'].addEventListener('click', () => {
            state.audioRoute = state.audioRoute === 'app' ? 'poweramp' : 'app';
            if (state.audioRoute === 'poweramp') state.audio.pause();
            updateAudioRouteUI(); savePlayerState(true);
        });
        el['offline-folder-btn'].addEventListener('click', triggerOfflineFolderScan);
        el['offline-folder-input'].addEventListener('change', (e) => { if (e.target.files && e.target.files.length) loadOfflineFiles(e.target.files); });
        el['mood-drawer-toggle'].addEventListener('click', () => { el['mood-drawer'].classList.toggle('open'); renderMoodChips(); });
        el['mood-chips'].addEventListener('click', (e) => { const c = e.target.closest('.mood-chip'); if (c) { state.activeMood = c.dataset.mood || 'all'; applyFilters(); } });
        [el['top-locate-btn'], el['hero-locate'], el['track-pos-pill'], el['locate-inline-btn']].forEach(b => { if (b) b.addEventListener('click', () => { if (window.innerWidth <= 1020 && el['player-panel'].classList.contains('mobile-fullscreen')) closeMobileModal(); scrollToActiveTrack(true); }); });
        el['sleep-btn'].addEventListener('click', cycleSleepTimer);
        el['repeat'].addEventListener('click', cycleRepeatMode);
        el['up-next-list'].addEventListener('click', (e) => { const it = e.target.closest('.up-next-item'); if (it) { const idx = parseInt(it.dataset.idx, 10); if (!isNaN(idx)) selectTrack(idx, true, true); } });
        document.querySelectorAll('.eq-btn').forEach(b => b.addEventListener('click', () => { ensureWebAudioGraph(); applyEqualizerPreset(b.dataset.eq, true); }));
        el['eta-card'].addEventListener('click', () => { el['eta-toast'].classList.toggle('show'); updateLiveEta(); });
        el['track-list'].addEventListener('click', (e) => {
            const fb = e.target.closest('.fav-btn');
            if (fb) { e.stopPropagation(); const id = fb.dataset.fav; if (state.favorites.has(id)) { state.favorites.delete(id); fb.classList.remove('loved'); fb.textContent = '♡'; } else { state.favorites.add(id); fb.classList.add('loved'); fb.textContent = '♥'; } saveFavorites(); if (state.activeMood === 'fav') applyFilters(); return; }
            const row = e.target.closest('.track-row'); if (row) { const idx = state.tracks.findIndex(t => t.id === row.dataset.id); if (idx !== -1) selectTrack(idx, true, false); }
        });
        el['play'].addEventListener('click', togglePlay);
        el['mini-play'].addEventListener('click', (e) => { e.stopPropagation(); togglePlay(); });
        el['mini-prev'].addEventListener('click', (e) => { e.stopPropagation(); playPrevTrack(); });
        el['mini-next'].addEventListener('click', (e) => { e.stopPropagation(); playNextTrack(false); });
        el['mobile-mini-bar'].addEventListener('click', openMobileModal);
        el['hero-play'].addEventListener('click', () => { if (state.filteredTracks.length) { const idx = state.tracks.findIndex(t => t.id === state.filteredTracks[0].id); selectTrack(idx !== -1 ? idx : state.currentIndex, true, true); } });
        el['previous'].addEventListener('click', playPrevTrack);
        el['next'].addEventListener('click', () => playNextTrack(false));
        el['back-10'].addEventListener('click', () => { state.audio.currentTime = Math.max(0, (state.audio.currentTime || 0) - 10); updateLiveEta(); savePlayerState(true); });
        el['forward-10'].addEventListener('click', () => { const dur = state.audio.duration || state.tracks[state.currentIndex]?.duration || 0; state.audio.currentTime = Math.min(dur, (state.audio.currentTime || 0) + 10); updateLiveEta(); savePlayerState(true); });
        el['shuffle'].addEventListener('click', () => { state.isShuffle = !state.isShuffle; el['shuffle'].classList.toggle('active', state.isShuffle); updateTrackLocatorAndQueue(); savePlayerState(true); });
        el['shuffle-top'].addEventListener('click', () => { state.isShuffle = true; el['shuffle'].classList.add('active'); savePlayerState(true); playNextTrack(true); });
        el['seek'].addEventListener('input', (e) => { const dur = state.audio.duration || state.tracks[state.currentIndex]?.duration || 1; state.audio.currentTime = (parseFloat(e.target.value) / 1000) * dur; updateLiveEta(); savePlayerState(false); });
        el['volume'].addEventListener('input', (e) => { ensureWebAudioGraph(); state.volume = parseFloat(e.target.value) / 100; el['vol-val'].textContent = Math.round(state.volume * 100) + '%'; applyAudioSettings(state.audio); savePlayerState(false); });
        el['spatial-toggle'].addEventListener('click', () => { ensureWebAudioGraph(); state.spatial = !state.spatial; el['spatial-toggle'].classList.toggle('active', state.spatial); el['visualizer-label'].textContent = state.spatial ? '🧠 NEURAL 360° 8D ORBIT' : 'STUDIO dB + kHz ZONES'; savePlayerState(true); });
        el['pitch-mode-toggle'].addEventListener('click', () => { state.preservesPitch = !state.preservesPitch; el['pitch-mode-toggle'].textContent = state.preservesPitch ? 'FLOW: PITCH LOCKED (VOCAL)' : 'FLOW: NATURAL VINYL (ZERO-LAG SMOOTH)'; applyAudioSettings(state.audio); savePlayerState(true); });
        document.querySelectorAll('.speed-btn').forEach(b => b.addEventListener('click', () => {
            state.playbackSpeed = parseFloat(b.dataset.speed);
            if (state.playbackSpeed !== 1.0) { state.preservesPitch = false; el['pitch-mode-toggle'].textContent = 'FLOW: NATURAL VINYL (ZERO-LAG SMOOTH)'; }
            document.querySelectorAll('.speed-btn').forEach(x => x.classList.toggle('active', parseFloat(x.dataset.speed) === state.playbackSpeed));
            applyAudioSettings(state.audio); applyThemeColors(); updateStats(); savePlayerState(true);
        }));
        el['search'].addEventListener('input', applyFilters);
        el['search-clear'].addEventListener('click', () => { el['search'].value = ''; applyFilters(); });
        document.addEventListener('keydown', (e) => {
            const tag = document.activeElement?.tagName.toLowerCase(); if (tag === 'input' || tag === 'textarea') return;
            if (e.key === ' ') { e.preventDefault(); togglePlay(); }
            else if (e.key === '/') { e.preventDefault(); el['search'].focus(); }
            else if (e.key === 'l' || e.key === 'L') { e.preventDefault(); scrollToActiveTrack(true); }
            else if (e.key === 'r' || e.key === 'R') { e.preventDefault(); cycleRepeatMode(); }
            else if (e.key === 'Escape') closeMobileModal();
            else if (e.key === 'ArrowRight') { e.preventDefault(); playNextTrack(e.shiftKey); }
            else if (e.key === 'ArrowLeft') { e.preventDefault(); playPrevTrack(); }
        });
        window.addEventListener('beforeunload', () => savePlayerState(true));
    }

    window.addEventListener('DOMContentLoaded', () => {
        if ('serviceWorker' in navigator && location.protocol.startsWith('http')) navigator.serviceWorker.register('?action=sw').catch(() => {});
        initDom(); loadSavedFavorites(); updateRepeatUI(); updateAudioRouteUI();
        const savedState = loadSavedPlayerState();
        initCanvas(); initAudioEvents(); initEvents(); loadPlaylist(savedState);
    });
})();
</script>
