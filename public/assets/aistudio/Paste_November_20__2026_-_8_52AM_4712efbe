    }

    function sendPowerampCommand(cmd, extraPath = '') {
        if (window.PCSNativeBridge && typeof window.PCSNativeBridge.controlPoweramp === 'function') {
            window.PCSNativeBridge.controlPoweramp(cmd, extraPath);
            return true;
        }
        return false;
    }

    /* OFFLINE ID3v2 COVER ART + METADATA EXTRACTOR */
    function readSynchsafeInt(v, o) {
        return ((v.getUint8(o) & 0x7f) << 21) | ((v.getUint8(o + 1) & 0x7f) << 14) | ((v.getUint8(o + 2) & 0x7f) << 7) | (v.getUint8(o + 3) & 0x7f);
    }
    function decodeId3Text(bytes, enc) {
        try {
            if (enc === 1 || enc === 2) return new TextDecoder('utf-16').decode(bytes).replace(/\0/g, '').trim();
            if (enc === 3) return new TextDecoder('utf-8').decode(bytes).replace(/\0/g, '').trim();
            return new TextDecoder('iso-8859-1').decode(bytes).replace(/\0/g, '').trim();
        } catch (e) { return ''; }
    }
    async function extractId3FromLocalFile(file) {
        const meta = { title: '', artist: '', album: '', cover_url: '' };
        try {
            const buf = await file.slice(0, Math.min(file.size, 524288)).arrayBuffer();
            const view = new DataView(buf);
            if (buf.byteLength < 10 || view.getUint8(0) !== 0x49 || view.getUint8(1) !== 0x44 || view.getUint8(2) !== 0x33) return meta;
            const ver = view.getUint8(3), limit = Math.min(buf.byteLength, readSynchsafeInt(view, 6) + 10);
            let o = 10;
            while (o + 10 < limit) {
                const fid = String.fromCharCode(view.getUint8(o), view.getUint8(o + 1), view.getUint8(o + 2), view.getUint8(o + 3));
                if (!/^[A-Z0-9]{4}$/.test(fid)) break;
                const fsz = ver === 4 ? readSynchsafeInt(view, o + 4) : view.getUint32(o + 4);
                if (fsz <= 0 || o + 10 + fsz > limit) break;
                const fd = new Uint8Array(buf, o + 10, fsz);
                if (fid === 'TIT2') meta.title = decodeId3Text(fd.subarray(1), fd[0]);
                else if (fid === 'TPE1') meta.artist = decodeId3Text(fd.subarray(1), fd[0]);
                else if (fid === 'TALB') meta.album = decodeId3Text(fd.subarray(1), fd[0]);
                else if (fid === 'APIC' && !meta.cover_url) {
                    const enc = fd[0]; let p = 1, mime = '';
                    while (p < fd.length && fd[p] !== 0) mime += String.fromCharCode(fd[p++]);
                    p += 2;
                    if (enc === 1 || enc === 2) { while (p + 1 < fd.length && !(fd[p] === 0 && fd[p + 1] === 0)) p += 2; p += 2; }
                    else { while (p < fd.length && fd[p] !== 0) p++; p++; }
                    if (p < fd.length) meta.cover_url = URL.createObjectURL(new Blob([fd.subarray(p)], { type: mime || 'image/jpeg' }));
                }
                o += 10 + fsz;
            }
        } catch (e) {}
        return meta;
    }

    async function loadOfflineFiles(fileList) {
        const audioFiles = Array.from(fileList || []).filter(f => /\.(mp3|flac|wav|m4a|ogg|opus|aac)$/i.test(f.name));
        if (!audioFiles.length) return;
        audioFiles.sort((a, b) => (b.lastModified || 0) - (a.lastModified || 0));
        state.isOfflineMode = true;
        el['library-status'].textContent = 'OFFLINE (' + audioFiles.length + ')';
        el['offline-folder-btn'].classList.add('active');

        const tracks = audioFiles.map((file, idx) => {
            const cleanName = file.name.replace(/\.[^/.]+$/, '').replace(/[_]+/g, ' ').trim();
            const parts = cleanName.split(' - ');
            return {
                id: 'off-' + idx + '-' + file.size + '-' + (file.lastModified || 0),
                title: parts.length > 1 ? parts.slice(1).join(' - ').trim() : cleanName,
                artist: parts.length > 1 ? parts[0].trim() : 'Offline Phonks',
                album: 'phonks (Offline)', duration: 0,
                audio_url: URL.createObjectURL(file), cover_url: '',
                native_path: TARGET_OFFLINE_DIR + '/' + file.name,
                added_at: Math.floor((file.lastModified || Date.now()) / 1000), _file: file
            };
        });

        state.tracks = tracks; state.activeMood = 'all';
        buildSmartMoodIndex(); applyFilters(); selectTrack(0, false, false);

        for (let i = 0; i < tracks.length; i++) {
            const tr = tracks[i];
            if (!tr._file) continue;
            const meta = await extractId3FromLocalFile(tr._file);
            if (meta.title) tr.title = meta.title;
            if (meta.artist) tr.artist = meta.artist;
            if (meta.album) tr.album = meta.album;
            if (meta.cover_url) {
                tr.cover_url = meta.cover_url;
                const rowImg = el['track-list'].querySelector(`.track-row[data-id="${CSS.escape(tr.id)}"] .thumb`);
                if (rowImg) rowImg.src = meta.cover_url;
                if (state.tracks[state.currentIndex]?.id === tr.id) {
                    updatePlayerCover(meta.cover_url);
                    el['now-title'].textContent = tr.title; el['now-artist'].textContent = tr.artist;
                    el['mini-title'].textContent = tr.title; el['mini-artist'].textContent = tr.artist;
                }
            }
            if (i % 8 === 0) await new Promise(r => setTimeout(r, 15));
        }
        buildSmartMoodIndex();
    }

    window.PCS_LOAD_NATIVE_OFFLINE_TRACKS = function(nativeTracksJson) {
        try {
            const list = typeof nativeTracksJson === 'string' ? JSON.parse(nativeTracksJson) : nativeTracksJson;
            if (!Array.isArray(list) || !list.length) return;
            list.sort((a, b) => (b.added_at || 0) - (a.added_at || 0));
            state.isOfflineMode = true; state.tracks = list; state.activeMood = 'all';
            buildSmartMoodIndex(); applyFilters();
            el['library-status'].textContent = 'APP OFFLINE (' + list.length + ')';
            el['offline-folder-btn'].classList.add('active');
            selectTrack(0, false, false);
        } catch (e) {}
    };

    function triggerOfflineFolderScan() {
        if (window.PCSNativeBridge && typeof window.PCSNativeBridge.scanFolder === 'function') {
            window.PCSNativeBridge.scanFolder(TARGET_OFFLINE_DIR);
            return;
        }
        el['offline-folder-input'].click();
    }

    function classifyTrackMoods(track) {
        const text = `${track.title} ${track.artist} ${track.album}`.toLowerCase();
        const moods = new Set();
        if (/(phonk|drift|funk|montagem|automotivo|brazilian|kordhell|interworld|dvdx|sxmpra|cowbell|memphis|sigma|gigachad|metamorphosis|rave|dxrk|ghostface|slaughter|murder|sahara|vendetta|krush|tuca|bibi)/i.test(text)) moods.add('phonk');
        if (/(sad|chill|lofi|lo-fi|slowed|reverb|alone|broken|pain|cry|tears|lonely|depress|heart|melody|love|rain|night|dream|soul|acoustic|unplugged|bgm|theme|kadhal|sogam|pirivu|kanneer|unakku|nenjame|poove|munbe|ennodu|uyire|anbe)/i.test(text)) moods.add('sad');
        if (/(happy|vibe|party|dance|club|summer|sun|joy|energy|pop|remix|dj|celebrate|groove|disco|funky|upbeat|kuthu|mass|celebration|vaathi|arabic|enjoy|good|feel|star|light|shine|magic|paradise|fever)/i.test(text)) moods.add('happy');
        if (/(bass|hard|hardstyle|trap|dubstep|edm|drop|heavy|boost|808|sub|subwoofer|ultra|extreme|dark|rage|metal|rock|gym|workout|beast|power|god|demon|hell|kill|war|vikram|rolex|leo|badass|kgf|kaithi)/i.test(text)) moods.add('bass');
        if (moods.size === 0) {
            const dur = parseFloat(track.duration) || 0;
            if (dur > 0 && dur < 155) { moods.add('phonk'); moods.add('bass'); }
            else if (dur >= 240) moods.add('sad');
            else moods.add('happy');
        }
        return moods;
    }

