    }

    /* AUDIO OUTPUT ROUTE: MY APP AUDIO <-> POWERAMP BRIDGE */
    function updateAudioRouteUI() {
        if (!el['audio-route-btn']) return;
        const isPA = state.audioRoute === 'poweramp';
        el['audio-route-btn'].textContent = isPA ? '⚡ POWERAMP' : '🎧 APP AUDIO';
